# SupportPulse AI - Environment Configuration

# Application
APP_NAME="SupportPulse AI"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Security
SECRET_KEY=supportpulse-insecure-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (Default: local SQLite database, or set to PostgreSQL URL)
DATABASE_URL=sqlite:///./data/supportpulse.db
# DATABASE_URL=postgresql://supportpulse:supportpulse@localhost:5432/supportpulse

# Model Configuration
MODELS_DIR=./models
ACTIVE_MODEL_VERSION=v1.0.0
HUMAN_TRIAGE_CONFIDENCE_THRESHOLD=0.65
SLA_ALERT_DEFAULT_RECALL=0.80

# Scheduler
SCHEDULER_INTERVAL_MINUTES=5
ENABLE_SCHEDULER=true

# Alert Integrations (Disabled by default per prompt rules)
WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
